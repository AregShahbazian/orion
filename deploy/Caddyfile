# Orion static hosting (Caddy). Serves:
#   /web/   -> the Flutter web build   (rsynced by the build-and-deploy workflow)
#   /apk/   -> the APK index + builds  (sc/rsynced by the workflow)
#
# Default: plain HTTP on :8080  ->  http://<vps-ip>:8080/web/  and  /apk/
#
# To use a real domain with automatic HTTPS instead:
#   1. point a DNS A-record at the VPS IP
#   2. replace the `:8080` line below with your domain, e.g.  orion.example.com {
#   3. open ports 80 + 443 (the systemd unit already grants CAP_NET_BIND_SERVICE)
# Caddy then provisions + renews a Let's Encrypt cert automatically.

:8080 {
	root * /root/orion/site
	file_server

	# Android only offers "install" (instead of dumping bytes) when the APK is served
	# with this MIME type.
	@apk path *.apk
	header @apk Content-Type application/vnd.android.package-archive

	# Bare / -> the generated landing page (site/index.html) listing every release.
}
