[Unit]
Description=Orion static site (Caddy)
Documentation=https://caddyserver.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Run as root so the web root lives under /root/orion/. Caddy keeps certs/state in
# /root/.local/share/caddy.
ExecStart=/usr/bin/caddy run --config /root/orion/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /root/orion/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=5
# Needed only if you switch the Caddyfile to a domain (binds :80/:443). Harmless on :8080.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
