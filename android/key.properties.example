# Template for android/key.properties (which is GITIGNORED — never commit the real one).
# Copy this to `key.properties` and fill in your keystore details.
#
# Keep the keystore OUTSIDE the repo. One keystore file may hold one alias per
# app (this app's alias is `orion`): storePassword is the file password;
# keyPassword is this alias's key password.
storePassword=your-keystore-password
keyPassword=your-orion-key-password
keyAlias=orion
storeFile=/absolute/path/to/your/keystore.jks
