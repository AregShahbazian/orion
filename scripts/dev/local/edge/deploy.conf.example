# Copy to `deploy.conf` (gitignored — contains the root PASSWORD; never commit it).
# Only needed for the FIRST provision of a brand-new VPS (password auth). Once setup.sh
# has saved .secrets/orion_ci, later runs use that key and ignore this file.
# Read by setup.sh to reach the VPS over SSH.

SERVER_IP=""             # the VPS IP
SERVER_USER="root"       # initial login user
SERVER_PASSWORD=""       # the root password set at provisioning
SERVER_SSH_PORT="22"     # host SSH port (optional; defaults to 22)
