[Unit]
Description=Orion static site (Caddy)
Documentation=https://caddyserver.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Run as root so the web root lives under /root/orion/. Caddy keeps certs/state in
# /root/.local/share/caddy.
# ORION_HOST (the public sslip.io host or a real domain) is supplied by setup.sh;
# the `-` makes a missing file non-fatal so `systemctl` won't fail before setup runs.
EnvironmentFile=-/root/orion/orion-web.env
ExecStart=/usr/bin/caddy run --config /root/orion/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /root/orion/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=5
# Lets Caddy bind :80/:443 for automatic HTTPS without running fully privileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
